# Optional settings for the root compose.yaml. Copy to .env and adjust as needed.
AF_DOCS_PORT=4391
AF_REGISTRY_PORT=4873
CONSTRUCTOR_URL=http://127.0.0.1:4176

# HTTPS profile: set these before issuing certificates and starting the proxy.
# REGISTRY_DOMAIN=npm.your-domain.org
# REGISTRY_PUBLIC_URL=https://npm.your-domain.org
# ACME_EMAIL=admin@your-domain.org

# The combined stack reuses the former local registry volume by default.
# Set this to alabuga-registry_storage to reuse the former production registry.
# REGISTRY_STORAGE_VOLUME=alabuga-registry_storage
# REGISTRY_CERTIFICATES_VOLUME=alabuga-registry_certificates
# REGISTRY_CHALLENGES_VOLUME=alabuga-registry_challenges
