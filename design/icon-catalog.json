    "method": "Local inventory and original SVG reuse only; no new Figma request."
  },
  "contract": {
    "defaultNamedSize": "M = 20 px",
    "sizes": {
      "S": 16,
      "M": 20,
      "L": 24
    },
    "legacy": "Bare .af-icon stays a 24 px wrapper. Size modifiers support custom children without stretching their SVG roots.",
    "button": "Combine af-btn__icon af-icon af-icon--NAME. Button size owns slot/source; Secondary Round L uses M = 20 px.",
    "semantics": "Decorative glyphs use aria-hidden=true; standalone meaningful glyphs need role=img and aria-label; icon-only buttons need an accessible name.",
    "motion": "Original two-color loaders rotate; reduced motion disables rotation; existing busy-button behavior is unchanged."
  },
